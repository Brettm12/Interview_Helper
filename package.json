{
  "name": "live-interview-helper",
  "version": "0.1.0",
  "productName": "Live Interview Helper",
  "description": "Local-first desktop assistant that listens to a live interview and surfaces your prepared answer beside the call.",
  "author": "Brett McCosham",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mock": "electron-vite dev --mode mock",
    "dev:web": "vite --config web.vite.config.ts --mode mock",
    "build": "electron-vite build",
    "build:web": "vite build --config web.vite.config.ts --mode mock",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-models": "node scripts/fetch-models.mjs",
    "verify:pixels": "npm run build:web && node tools/verify/compare.mjs",
    "e2e": "node tools/verify/e2e.mjs",
    "e2e:electron": "npm run build && node tools/verify/e2e-electron.mjs",
    "package": "npm run build && electron-builder --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "smoke:package": "node tools/verify/smoke-package.mjs",
    "probe:windows": "node tools/verify/windows-probe.mjs",
    "probe:wasm": "node tools/verify/wasm-probe.mjs",
    "probe:editor": "node tools/verify/editor-probe.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@huggingface/transformers": "3.8.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.2",
    "undici": "^6.28.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
